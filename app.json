{
  "expo": {
    "name": "supreme",
    "slug": "supreme",
    "scheme": "yourfurnitureapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#222222"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#222222"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.racksracksracks.supreme"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font", "expo-sqlite"],
    "extra": {
      "eas": {
        "projectId": "06bb95f5-1f62-42a0-90a5-20ba6e391660"
      }
    }
  }
}
